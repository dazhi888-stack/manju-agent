# 复制本文件为 .env 并填入真实 Key（.env 已被 .gitignore 排除，不会上传）
# 也可直接使用系统环境变量（优先级更高）。

# ---------- DeepSeek（剧本/分镜/对话主模型） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：免费/付费模型分流（不填则全部用 DEEPSEEK_MODEL）
# SCRIPT_MODEL_FREE=deepseek-chat
# SCRIPT_MODEL_PRO=deepseek-reasoner

# ---------- 硅基流动（Z-Image 分镜图 / 向量 embedding） ----------
# GJLD_* 与 SILICONFLOW_* 二选一即可，均指向 https://api.siliconflow.cn/v1
GJLD_API_KEY=sk-xxxxxxxxxxxxxxxx
GJLD_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 图片生成（分镜图，走硅基流动 Z-Image） ----------
IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxx
IMAGE_API_URL=https://api.siliconflow.cn/v1/images/generations
IMAGE_API_MODEL=Kwai-Kolors/Kolors
IMAGE_SIZE=1024x1024
# 全局负面提示词（可选）
# IMAGE_NEGATIVE_BASE=

# ---------- 视频生成（Seedance，当前为预留接口，可不填） ----------
# SEEDANCE_API_KEY=
# SEEDANCE_URL=
# SEEDANCE_MODEL=

# ---------- LangSmith 追踪（可选，不填则关闭） ----------
# LANGSMITH_TRACING=true
# 需同时设置 LANGSMITH_API_KEY / LANGSMITH_PROJECT

# ---------- 运行期选项（可选） ----------
# 指定默认故事 ID（不填则交互选择）
# ACTIVE_STORY_ID=story_001
# 全局画风描述，会注入分镜图提示词
# STYLE_DESC=
